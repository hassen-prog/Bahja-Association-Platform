cat > .gitignore <<'EOF'
# Angular frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/

# Spring Boot backend
backend/target/
backend/.idea/
backend/*.iml
backend/uploads/
backend/*.log

# Local environment and credentials
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/src/main/resources/application-local.properties

# Archives and backups
*.rar
*.zip
*.7z

# Operating system files
.DS_Store
Thumbs.db
EOF